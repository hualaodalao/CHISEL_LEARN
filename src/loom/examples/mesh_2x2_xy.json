    { "id": "m1", "kind": "rn-i", "clock": "core", "attach": "r00",
      "protocol": "chi", "dataWidth": 128, "outstanding": 4, "qos": 8 },
    { "id": "s0", "kind": "sn-f", "clock": "core", "attach": "r11",
      "protocol": "chi", "dataWidth": 128, "outstanding": 1 },
    { "id": "s1", "kind": "sn-f", "clock": "core", "attach": "r11",
      "protocol": "chi", "dataWidth": 128, "outstanding": 1 }
