      { "qosMin": 8, "qosMax": 15, "class": "ctl" },
      { "qosMin": 4, "qosMax": 7,  "class": "lat" },
      { "qosMin": 0, "qosMax": 3,  "class": "bulk" }
    ],
    "classes": [
