      { "from": "r10", "to": "r11", "channels": ["req","rsp","dat","snp"], "pipe": 1 },
      { "from": "r11", "to": "r10", "channels": ["req","rsp","dat","snp"], "pipe": 1 },
      { "from": "r01", "to": "r11", "channels": ["req","rsp","dat","snp"], "pipe": 1 },
      { "from": "r11", "to": "r01", "channels": ["req","rsp","dat","snp"], "pipe": 1 },
      { "from": "r11", "to": "s0", "channels": ["req","rsp","dat","snp"] },
