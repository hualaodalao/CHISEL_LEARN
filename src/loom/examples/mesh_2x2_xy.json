      { "name": "r10", "clock": "core", "routing": "xy", "pos": { "x": 1, "y": 0 } },
      { "name": "r01", "clock": "core", "routing": "xy", "pos": { "x": 0, "y": 1 } },
      { "name": "r11", "clock": "core", "routing": "xy", "pos": { "x": 1, "y": 1 } }
